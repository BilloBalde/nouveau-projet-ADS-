# =============================================================================
#  MODÈLE DE DÉPLOIEMENT — Coleah Bandeya & Fils
#
#  Copier ce fichier en « .env » sur le serveur, puis renseigner les quatre
#  points ci-dessous avant toute mise en ligne :
#
#    1. APP_URL          le domaine réel du site
#    2. APP_KEY          généré par « php artisan key:generate »
#    3. DB_*             base de données, utilisateur et mot de passe
#    4. MAIL_*           serveur d'envoi des e-mails
#
#  Les valeurs de ce fichier sont celles d'une mise en production. Ne pas
#  repasser APP_DEBUG à true sur un serveur accessible depuis Internet : la
#  moindre erreur y afficherait alors les chemins du serveur, les requêtes SQL
#  et le contenu de ce fichier.
# =============================================================================

APP_NAME="Coleah Bandeya & Fils"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ⚠️  À RENSEIGNER — domaine réel, sans barre oblique finale.
#     Exemple : https://coleahbandeya.com
#     Sert aux liens de réinitialisation de mot de passe et aux images des
#     e-mails et des PDF : une valeur erronée les fait pointer ailleurs.
APP_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Tarifs de gros (remise automatique selon la quantité : 3+ -5%, 5+ -10%, 10+ -15%).
# Laisser à false pour vendre au prix affiché quelle que soit la quantité.
PRICING_TIERS_ENABLED=false

# Mode de vente de l'installation.
#   caisse      : chaque vente est saisie au point de vente (fonctionnement
#                 historique, celui des installations déjà livrées).
#   inventaire  : la boutique vend sans rien saisir, puis compte son stock à
#                 intervalle régulier. Ce qui a disparu entre deux comptages,
#                 achats et transferts déduits, a été vendu. La caisse et la
#                 saisie des ventes sont alors fermées, pour qu'il n'y ait
#                 qu'une seule source de chiffre d'affaires.
#
# ⚠️  En mode « inventaire », le prix de vente est la SEULE source du chiffre
#     d'affaires : les prix doivent être saisis à la main sur les fiches
#     produit. Laissés en automatique, un achat les recalcule (prix de revient
#     + marge) et le chiffre d'affaires de la période suit ce nouveau prix.
SALES_MODE=caisse

# Marge ajoutée au prix de revient pour proposer le prix de vente, en pourcentage.
# Appliquée à la création d'un produit et à chaque achat qui le réapprovisionne.
# Un prix de vente fixé à la main sur une fiche produit n'est plus recalculé :
# il faut resaisir le prix conseillé pour remettre ce produit en automatique.
PRICING_SALE_MARGIN=30

# daily : un fichier par jour, 14 jours conservés. Ne pas remettre « single »,
# qui écrit dans un fichier unique grossissant sans fin.
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ⚠️  À RENSEIGNER
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coleah_bandeya
DB_USERNAME=
DB_PASSWORD=

# Chemin de mysqldump si l'exécutable n'est pas dans le PATH du serveur.
# Utilisé par la sauvegarde quotidienne (php artisan db:backup).
DB_DUMP_BINARY=mysqldump

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Réserve le cookie de session au HTTPS.
# ⚠️  Si le site démarre en HTTP, commenter cette ligne : sinon plus personne
#     ne parvient à se connecter, sans message d'erreur explicite.
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ⚠️  À RENSEIGNER — « mailpit » n'existe que sur un poste de développement.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# SMS : aucun fournisseur n'est en place sur ce projet. « log » n'envoie rien et
# journalise le message. Le bouton d'envoi des relances de dettes reste masqué
# tant qu'un pilote réel n'est pas configuré ici.
SMS_DRIVER=log
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Paiement en ligne. USE_MOCK reste à true tant que les identifiants sont vides :
# le passer à false sans identifiants ferait échouer le paiement en production.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_COUNTRY=GN
ORANGE_MONEY_CURRENCY=GNF
ORANGE_MONEY_NOTIF_URL=
ORANGE_MONEY_RETURN_URL=
ORANGE_MONEY_CANCEL_URL=
ORANGE_MONEY_USE_MOCK=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
